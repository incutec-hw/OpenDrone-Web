  "_boardNote": "Each entry merges into one group at load: substrate fragments named <prefix>_pad/_silkscreen/_soldermask/_PCB, plus every occurrence standing on the board. 'exclude' keeps things that merely pass through the board plane (standoffs, stack screws) out of it.",
  "boards": [
    {
      "id": "OpenFC",
      "title": "OpenFC-Lite-Mini",
      "note": "RP2354B flight controller"
    },
    {
      "id": "4in1-mini",
      "title": "OpenESC-20x20",
      "note": "4-in-1 AM32 ESC"
    },
    {
      "id": "OpenRX-Mono",
      "title": "OpenRX-Mono",
      "note": "ELRS receiver"
    }
  ],
  "boardExclude": "(screw|hex nut|pressnut|press nut|washer|softmount|Standoff|20mmx4mm|Casing|^Arm$|^Cross$|^Base-|^Top$|DJI|VTX-Mount|Bumper|AirTag|Boot-|Admi|BM6B|^[0-9]+$)",
  "videoModule": "^(Top Casing|Bottom Casing|DJI|VTX-Mount|USB C|Body|Lens|BM6B)",
  "notFrame": "^(Admi|prop-pivot|[0-9]+$)",
  "_beatNote": "select is one of: {board}, {names}, {cluster} one spatial cluster, {complement} everything not in another beat. choreo names a built-in behaviour.",
  "beats": [
    {
      "id": "whole",
      "title": "OpenDrone 3\"",
      "note": "complete airframe",
