      "id": "carbon",
      "label": "carbon fibre",
      "match": "^(Arm|Cross|Base-Top|Base-Bot|Top)$",
      "tint": "#000000",
      "metalness": 0,
      "roughness": 0.19,
      "env": 0.37,
      "sat": 2.04
    },
    {
      "id": "alu",
      "label": "aluminium",
